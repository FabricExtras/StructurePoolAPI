{
  "schemaVersion": 1,
  "id": "structure_pool_api",
  "version": "${version}",
  "name": "Structure Pool API",
  "description": "Allows injecting structures into structure pools.",
  "authors": [
    "Daedelus"
  ],
  "contact": {
    "repo": "https://github.com/FabricExtras/StructurePoolAPI"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rpg_foundation.structure_pool.fabric.FabricMod"
    ]
  },
  "mixins": [
    "structure_pool_api.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_min_version}",
    "java": ">=21"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}